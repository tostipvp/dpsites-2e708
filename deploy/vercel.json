{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(images|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ],
  "redirects": [
    { "source": "/offerte", "destination": "/contact", "permanent": true },
    { "source": "/diensten", "destination": "/services", "permanent": true },
    { "source": "/prijzen", "destination": "/pricing", "permanent": true },
    { "source": "/over", "destination": "/about", "permanent": true }
  ]
}
