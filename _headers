# =====================================================================
# _headers — Netlify leest dit bestand bij ELKE deploy, ook bij drag-and-drop.
# Beveiliging voor alle pagina's + caching voor beeld en iconen.
# CSS/JS krijgen bewust géén lange cache: Netlify ververst die direct na
# elke deploy (ETag), zodat klanten meteen je nieuwste versie zien.
# =====================================================================
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# Afbeeldingen en iconen 1 week cachen. Vervang je een foto? Geef hem een nieuwe naam.
/images/*
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=604800
